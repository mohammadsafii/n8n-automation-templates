        "jsCode": "const content = $input.first().json.choices[0].message.content;\nconst jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\nconst parsed = JSON.parse(jsonMatch[0]);\nreturn [{ json: parsed }];;"
